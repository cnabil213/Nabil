# Les rushes ne vont JAMAIS dans git : trop lourds, et git ne sait pas
# versionner du binaire. On dépose les vidéos dans /mnt/user-data/working.
*.mp4
*.mov
*.MP4
*.MOV
*.avi
*.mkv
*.wav
*.mp3
*.m4a

# Sorties d'analyse : régénérables en une commande, on garde le dépôt léger.
analyse-*/
!analyses/

# Python
__pycache__/
*.pyc

# Sorties de ecoute-video / vision-video / comparer-prises : régénérables
ecoute-*/
vision-*/
comparaison-*/

# venvs locaux (torch pour l'arousal) et caches python
venv*/
outils/venv-arousal/
.pytest_cache/

# Cache de transcriptions de comparer-prises
outils/ecoute/cache/

# Samples fournis par Nabil (contenu tiers, jamais dans le dépôt)
samples/

# La banque de sons de Nabil vit DANS le dépôt (clips courts) : on lève l'exclusion globale *.wav pour elle
!banque-son/
!banque-son/*.wav

# modèle de visage (3,6 Mo, se retéléchargé : voir outils/README.md)
outils/face_landmarker.task

# les livraisons finales, elles, sont versionnées (le chat plafonne à 30 Mio, pas GitHub)
!livraisons/
!livraisons/*.mp4
